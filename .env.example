# ================= LLM 配置 =================
# 可选值: mock | openai_compatible | azure_openai
# mock: 无需任何 API Key，使用内置大厨响应（用于演示与 CI）
LLM_PROVIDER=mock

# ---- openai_compatible（DeepSeek / 硅基流动 等 OpenAI 兼容协议）----
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# ---- azure_openai ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ================= 应用配置 =================
# 默认模型（azure 场景使用）
DEFAULT_MODEL=gpt-4
# 辩论轮次（两位大厨轮流发言，3 轮 = 共 6 条发言）
DEBATE_ROUNDS=3
# 数据库连接串（开发使用 SQLite）
DATABASE_URL=sqlite:///./foodie.db
# 单 IP 每分钟请求上限（频控）
RATE_LIMIT=60

# ================= 服务配置 =================
# 后端服务端口
API_PORT=8000
# 前端 Streamlit 端口
STREAMLIT_PORT=8501
